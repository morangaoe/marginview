DATABASE_URL=postgres://localhost:5432/marginview
# Required in production (the API refuses to start without it). Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated emails that can open Platform admin (all workspaces, users, error log)
PLATFORM_ADMIN_EMAILS=
# Self-service sign-up is off: only people added by an owner or platform admin can sign in
ALLOW_PUBLIC_SIGNUP=false
# Migrations run on API start; set false to run `npm run migrate` by hand instead
AUTO_MIGRATE=true
PORT=4000
FRONTEND_URL=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://localhost:6379
SCRAPING_API_KEY=
SCRAPING_PROVIDER=zenrows
BRIGHTDATA_WS_ENDPOINT=
SERPAPI_KEY=
ENFORCE_SCRAPING_CREDITS=false
# Google country for market search (us, uk, de, ...). Defaults from the org currency; set it for EUR.
SERPAPI_GL=
# true = log every fetch tier, SerpAPI call and Redis reconnect for the scraper
SCRAPE_DEBUG=false
# Stripe (cards, Apple/Google Pay, bank debits worldwide). Leave empty to keep checkout off.
STRIPE_SECRET_KEY=
# From the webhook endpoint https://<api>/api/billing/webhook (events: checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back to (defaults to the first FRONTEND_URL)
APP_URL=

# Google sign-in (optional). OAuth client ID from Google Cloud Console; add your web origin under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# SendGrid email sign-in links (optional). MAIL_FROM must be a verified sender in SendGrid.
SENDGRID_API_KEY=
MAIL_FROM=
