# Supabase: use the Session pooler string (Project Settings -> Database -> Connection string -> Session pooler,
# port 5432). It is IPv4-compatible and supports pg_advisory_lock, which the scheduler needs.
# Do NOT use the Transaction pooler (port 6543).
DATABASE_URL=postgres://localhost:5432/marginview
# Force TLS for non-Supabase hosts (Supabase URLs are detected automatically)
DATABASE_SSL=false
# Required in production (the API refuses to start without it). Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated emails that can open Platform admin (all workspaces, users, error log)
PLATFORM_ADMIN_EMAILS=
# Self-service sign-up is off: only people added by an owner or platform admin can sign in
ALLOW_PUBLIC_SIGNUP=false
# First login on a new database: creates an owner account for the first PLATFORM_ADMIN_EMAILS address
# (only if that email has no account). Remove it once you have signed in.
BOOTSTRAP_ADMIN_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts API keys customers save; never change it later.
ENCRYPTION_KEY=
# Migrations run on API start; set false to run `npm run migrate` by hand instead
AUTO_MIGRATE=true
PORT=4000
# On Render this defaults to the service's own URL (RENDER_EXTERNAL_URL); set it to add a custom domain.
FRONTEND_URL=http://localhost:5173,http://localhost:5174
# Shared secret for POST /internal/tick, called every minute by Supabase pg_cron (docs/MIGRATION.md). Leave empty to disable.
CRON_SECRET=
SCRAPING_API_KEY=
# zenrows | scrapingbee | scraperapi | crawlbase
SCRAPING_PROVIDER=zenrows
# crawlbase only: JavaScript token used for rendered fetches
SCRAPING_API_KEY_JS=
BRIGHTDATA_WS_ENDPOINT=
SERPAPI_KEY=
ENFORCE_SCRAPING_CREDITS=false
# Google country for market search (us, uk, de, ...). Defaults from the org currency; set it for EUR.
SERPAPI_GL=
# true = log every fetch tier, SerpAPI call for the scraper
SCRAPE_DEBUG=false
# Stripe (cards, Apple/Google Pay, bank debits worldwide). Leave empty to keep checkout off.
STRIPE_SECRET_KEY=
# From the webhook endpoint https://<api>/api/billing/webhook (events: checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back to (defaults to the first FRONTEND_URL)
APP_URL=

# Google sign-in (optional). OAuth client ID from Google Cloud Console; add your web origin under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# SendGrid email sign-in links (optional). MAIL_FROM must be a verified sender in SendGrid.
SENDGRID_API_KEY=
MAIL_FROM=

# Scrapy fetch tier, tried after a plain fetch and before paid providers.
# SCRAPY_LOCAL=true runs it inside this process's container (set by the Docker image).
# Or point SCRAPY_URL at a separate service (apps/scrapy/server.py) with SCRAPY_TOKEN.
SCRAPY_LOCAL=false
SCRAPY_URL=
SCRAPY_TOKEN=
